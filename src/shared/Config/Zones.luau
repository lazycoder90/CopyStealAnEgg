Zones.count = #Zones.list
Zones.slotsPerZone = 8

function Zones.get(index: number): Zone
	local z = Zones.list[index]
	assert(z, "zona tidak ada: " .. tostring(index))
	return z
end

-- Rarity (1..10) untuk slot 1..8 pada zona z. Aturan jendela, dengan batas atas 10.
local SLOT_OFFSETS = { 0, 0, 1, 1, 2, 3, 4, 5 }
function Zones.slotRarity(zoneIndex: number, slot: number): number
	local o = (zoneIndex - 1) // 2
	return math.min(o + SLOT_OFFSETS[slot] + 1, 10)
end

return Zones
