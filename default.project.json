{
	"name": "NestBandits",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Packages": {
				"$path": "Packages"
			},
			"Assets": {
				"$path": "assets"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			},
			"ServerPackages": {
				"$path": "ServerPackages"
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
